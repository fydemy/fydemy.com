generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id            String        @id
  name          String
  email         String        @unique
  emailVerified Boolean       @default(false)
  image         String?
  role          String        @default("applicant")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  accounts      Account[]
  sessions      Session[]
  applications   Application[]
  materialItems  MaterialItem[]
  staffFiles     ApplicationStaffFile[]
  invitesSent    Invite[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Application {
  id              String            @id @default(cuid())
  name            String
  description     String
  logoUrl         String?
  websiteUrl      String?
  linkedin        String            @default("")
  discordUsername String            @default("")
  pitchDeckUrl     String
  pitchDeckName    String
  status          ApplicationStatus @default(PENDING)
  cohort          String            @default("F26")
  reviewNote      String?
  reviewedAt      DateTime?
  feePaid         Boolean           @default(false)
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  members         Member[]
  launches        Launch[]
  kanbanLogs      ApplicationKanbanLog[]
  staffFiles      ApplicationStaffFile[]
  workspaceFolder MaterialItem?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([userId])
  @@index([status])
  @@index([cohort])
  @@map("application")
}

model Member {
  id            String      @id @default(cuid())
  name          String
  email         String
  linkedin      String
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("member")
}

model Launch {
  id            String      @id @default(cuid())
  title         String
  slug          String      @unique
  content       String
  youtubeUrl    String?
  socialEmbeds  String[]    @default([])
  featured      Boolean     @default(false)
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([applicationId])
  @@index([featured])
  @@map("launch")
}

enum MaterialType {
  FOLDER
  FILE
}

model MaterialItem {
  id          String         @id @default(cuid())
  name        String
  type        MaterialType
  content           String?
  mentorEditable    Boolean        @default(false)
  applicantEditable Boolean        @default(false)
  locked            Boolean        @default(false)
  applicationId     String?        @unique
  application       Application?   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  parentId       String?
  parent      MaterialItem?  @relation("MaterialTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    MaterialItem[] @relation("MaterialTree")
  createdById String
  createdBy   User           @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([parentId])
  @@index([createdById])
  @@map("material_item")
}

model ApplicationKanbanLog {
  id            String      @id @default(cuid())
  cardId        String      @unique
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  title         String
  notes         String      @default("")
  tag           String      @default("")
  status        String
  visibility    String      @default("public")
  authorUserId  String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([applicationId])
  @@map("application_kanban_log")
}

model Invite {
  id          String    @id @default(cuid())
  email       String    @unique
  role        String
  invitedById String
  invitedBy   User      @relation(fields: [invitedById], references: [id], onDelete: Cascade)
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([invitedById])
  @@map("invite")
}

model ApplicationStaffFile {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  name          String
  content       String
  createdById   String
  createdBy     User        @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([applicationId])
  @@map("application_staff_file")
}
